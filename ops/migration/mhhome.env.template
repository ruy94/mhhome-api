# Copy to /opt/common-infra/projects/mhhome.env and replace the two passwords.
# This is sourced by provision-project.sh: shell-quote secrets correctly.
PROJECT_SLUG=mhhome
PROJECT_DB=mhhome
PROJECT_DB_USER=postgres
# Use the EXISTING common-infra postgres password: provisioning also ALTERs this role.
PROJECT_DB_PASSWORD='REPLACE_WITH_EXISTING_COMMON_POSTGRES_PASSWORD'
REDIS_DB=6
REDIS_KEY_PREFIX=mhhome:prod:
REDIS_QUEUE_PREFIX=mhhome-prod
MINIO_MEDIA_BUCKET=mhhome-media
MINIO_ACCESS_KEY=mhhome_media
MINIO_SECRET_KEY='REPLACE_WITH_MHHOME_MEDIA_SECRET'
