# Merge these changes into a COPY of the OLD MH Home API .env.production.
# Keep every JWT / Zalo / SionHub / shipping / SaleWork / Marketplace secret and flag.
# Do not copy another shop's .env and do not source a dotenv file in a shell.
NODE_ENV=production
PORT=3000
# Docker-internal ports NEVER change during host port cutover 5433/6380 -> 5432/6379.
DATABASE_URL=postgresql://postgres:URL_ENCODED_EXISTING_COMMON_PASSWORD@postgres-all:5432/mhhome?schema=public
REDIS_HOST=redis-all
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=6
REDIS_KEY_PREFIX=mhhome:prod:
REDIS_QUEUE_PREFIX=mhhome-prod
MINIO_ENDPOINT=http://minio-all:9000
MINIO_REGION=ap-southeast-1
MINIO_ACCESS_KEY=mhhome_media
MINIO_SECRET_KEY=REPLACE_WITH_MHHOME_MEDIA_SECRET
MINIO_MEDIA_BUCKET=mhhome-media
MINIO_FORCE_PATH_STYLE=true
UPLOAD_TEMP_DIR=/tmp/mhhome-api/uploads
CORS_ORIGINS=https://mhhome.shop,https://www.mhhome.shop,https://admin.mhhome.shop,https://www.admin.mhhome.shop,https://media.mhhome.shop,https://sion.gospelserver.click,https://h5.zdn.vn
MARKETPLACE_MEDIA_IMAGE_BASE_URL=https://media.mhhome.shop/mhhome-media/images
MARKETPLACE_MEDIA_VIDEO_BASE_URL=https://media.mhhome.shop/mhhome-media/videos
MARKETPLACE_MEDIA_THUMBNAIL_BASE_URL=https://media.mhhome.shop/mhhome-media/thumbnails
