# Make a chmod-600 copy OUTSIDE Git, replace placeholders, then source that copy.
# Shell-quote values. Database URL password components must be percent-encoded.
# Both URLs connect from the HOST; docker hostnames belong only in API runtime env.
# Phase 1: old host PostgreSQL stays on 5432; common-infra publishes 5433.
# After ALL projects migrate and final port cutover succeeds, host clients use 5432.
# Archive this migration config then: LEGACY_DATABASE_URL no longer identifies the old server.
LEGACY_DATABASE_URL='postgresql://postgres:ENCODED_OLD_PASSWORD@127.0.0.1:5432/mhhome'
TARGET_DATABASE_URL='postgresql://postgres:ENCODED_COMMON_PASSWORD@127.0.0.1:5433/mhhome'

# pg_dump/psql use separate connection fields so passwords are not CLI arguments.
LEGACY_PGHOST=127.0.0.1
LEGACY_PGPORT=5432
LEGACY_PGUSER=postgres
LEGACY_PGPASSWORD='REPLACE_OLD_PASSWORD'

MIGRATION_MINIO_ENDPOINT=http://127.0.0.1:9999
MIGRATION_MINIO_REGION=ap-southeast-1
MIGRATION_MINIO_ACCESS_KEY=mhhome_media
MIGRATION_MINIO_SECRET_KEY='REPLACE_WITH_MHHOME_MEDIA_SECRET'
MIGRATION_MINIO_BUCKET=mhhome-media
